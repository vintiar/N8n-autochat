{
  "name": "03 - Restoran Sasak Lombok - Customer Feedback",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "id": "d1111111-1111-1111-1111-111111111111",
      "name": "Setiap 30 Menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Orders", "mode": "name" },
        "filtersUI": { "values": [{ "lookupColumn": "status", "lookupValue": "confirmed" }] },
        "options": { "returnAllMatches": true }
      },
      "id": "d2222222-2222-2222-2222-222222222222",
      "name": "Ambil Pesanan Confirmed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [440, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst fortyFiveMins = 45 * 60 * 1000;\n\nconst eligible = $input.all().filter(item => {\n  const orderTime = new Date(item.json.order_time).getTime();\n  const age = now - orderTime;\n  return age >= fortyFiveMins && item.json.status === 'confirmed' && item.json.phone;\n});\n\nreturn eligible.map(item => ({\n  json: {\n    order_id: item.json.order_id,\n    phone: item.json.phone,\n    customer_name: item.json.customer_name || 'Kak',\n    items: item.json.items,\n    feedback_msg: `Halo ${item.json.customer_name || 'Kak'}! 😊\\n\\nTerima kasih sudah memesan di *Restoran Sasak Lombok*!\\n\\nBagaimana pesanannya?\\n${item.json.items ? '(' + item.json.items + ')' : ''}\\n\\nBerikan rating 1-5:\\n5 = Sangat Puas\\n4 = Puas\\n3 = Cukup\\n2 = Kurang\\n1 = Sangat Kurang\\n\\nKetik angkanya ya! 🙏`\n  }\n}));"
      },
      "id": "d3333333-3333-3333-3333-333333333333",
      "name": "Filter Siap Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [{ "id": "c1", "leftValue": "={{ $items().length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }],
          "combinator": "and"
        }, "options": {}
      },
      "id": "d4444444-4444-4444-4444-444444444444",
      "name": "Ada Yang Perlu Feedback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" }] },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ number: $json.phone, text: $json.feedback_msg }) }}",
        "options": { "timeout": 8000 }
      },
      "id": "d5555555-5555-5555-5555-555555555555",
      "name": "Kirim Request Feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 220]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Orders", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": { "order_id": "={{ $json.order_id }}", "status": "feedback_sent" },
          "matchingColumns": ["order_id"], "schema": []
        }, "options": {}
      },
      "id": "d6666666-6666-6666-6666-666666666666",
      "name": "Update Order Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1320, 220],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "operation": "upsert",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Sessions", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "phone": "={{ $('Filter Siap Feedback').item.json.phone }}",
            "state": "awaiting_feedback",
            "feedback_pending_order_id": "={{ $('Filter Siap Feedback').item.json.order_id }}",
            "last_updated": "={{ new Date().toISOString() }}"
          },
          "matchingColumns": ["phone"], "schema": []
        }, "options": {}
      },
      "id": "d7777777-7777-7777-7777-777777777777",
      "name": "Set Session Awaiting Feedback",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1540, 220],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Sheets" } }
    }
  ],
  "connections": {
    "Setiap 30 Menit": { "main": [[{ "node": "Ambil Pesanan Confirmed", "type": "main", "index": 0 }]] },
    "Ambil Pesanan Confirmed": { "main": [[{ "node": "Filter Siap Feedback", "type": "main", "index": 0 }]] },
    "Filter Siap Feedback": { "main": [[{ "node": "Ada Yang Perlu Feedback?", "type": "main", "index": 0 }]] },
    "Ada Yang Perlu Feedback?": { "main": [[{ "node": "Kirim Request Feedback", "type": "main", "index": 0 }], []] },
    "Kirim Request Feedback": { "main": [[{ "node": "Update Order Status", "type": "main", "index": 0 }]] },
    "Update Order Status": { "main": [[{ "node": "Set Session Awaiting Feedback", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "restoran-lombok-feedback",
  "tags": [{ "id": "1", "name": "Restoran Lombok" }]
}
